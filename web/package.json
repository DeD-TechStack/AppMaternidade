  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "tema": "node scripts/gerar-tema.mjs",
    "lint:harmonia": "node -e \"process.env.HARMONIA_LINT='1';const{spawnSync:s}=require('node:child_process');const t=(a,ok)=>{const r=s(process.execPath,a,{stdio:'inherit'});if(!ok.includes(r.status))process.exit(r.status||1)};t(['node_modules/eslint/bin/eslint.js','.'],[0,1]);t(['node_modules/stylelint/bin/stylelint.mjs','src/**/*.css'],[0,2])\"",
    "test": "vitest run",
    "build": "vite build",
    "check": "npm run typecheck && npm run lint && npm run build && npm run test"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@supabase/supabase-js": "2.119.0",
    "lucide-react": "1.69.0",
    "motion": "12.43.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@google/design.md": "0.4.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "30.1.3",
    "stylelint": "18.0.0",
    "stylelint-declaration-strict-value": "1.13.0",
    "tailwindcss": "4.3.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
